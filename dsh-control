#!/usr/bin/python3
"""Desktop controls for configured local and remote DSH targets."""
import json
from pathlib import Path
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

from dsh_config import load_runtime, targets

REFRESH_TIMEOUT = 600


def configured_targets():
    return targets(load_runtime())


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def active(unit):
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit]).returncode == 0


def listening(port):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.3):
            return True
    except OSError:
        return False


def ready(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=1) as response:
            return response.status == 200
    except urllib.error.HTTPError as exc:
        # DSH may require browser authentication even for its root page.
        return exc.code == 401
    except (OSError, urllib.error.URLError):
        return False


def notify(message, failed=False):
    subprocess.run(["notify-send", "-a", "DeepSeek Harness", "-u",
                    "critical" if failed else "normal", "DeepSeek Harness", message], check=False)


def start(target):
    target_config = configured_targets()[target]
    unit, port = target_config["unit"], target_config["port"]
    if not active(unit):
        if listening(port):
            raise RuntimeError(f"Port {port} is already in use outside {unit}. Stop the manually started service or tunnel first.")
        run("systemctl", "--user", "start", unit)
    deadline = time.monotonic() + 45
    while time.monotonic() < deadline:
        if not active(unit):
            raise RuntimeError(f"{unit} stopped. Use the menu's Logs action to see why.")
        if ready(port):
            return
        time.sleep(0.5)
    raise RuntimeError(f"No web response on port {port} after 45 seconds. Check Logs; the service or tunnel may still be starting.")


def local_url():
    # DSH prints a per-process login URL. Keep it out of notifications and stdout.
    local = configured_targets()["local"]
    unit = local["unit"]
    invocation = run("systemctl", "--user", "show", unit, "-p", "InvocationID", "--value",
                     capture_output=True, text=True).stdout.strip()
    if not invocation:
        raise RuntimeError("Cannot identify the local service invocation. Try Stop, then Open again.")
    logs = run("journalctl", "--user", f"_SYSTEMD_INVOCATION_ID={invocation}", "-o", "json", "--no-pager",
               capture_output=True, text=True).stdout
    for line in reversed(logs.splitlines()):
        message = json.loads(line).get("MESSAGE", "")
        match = re.search(rf"dsh web: (http://(?:localhost|127\.0\.0\.1):{local['port']}/\S*)", message)
        if match:
            return match.group(1)
    raise RuntimeError("The local service has not printed its login URL. Check Logs, then try Open again.")


def installed_version(home):
    # npx derives its cache directory from the exact package spec, so this
    # matches the unversioned spec the service launches DSH with.
    root = home / ".npm/_npx"
    versions = set()
    for manifest in () if not root.is_dir() else root.glob("*/node_modules/@deepseek-ai/dsh/package.json"):
        try:
            version = json.loads(manifest.read_text()).get("version")
        except (ValueError, OSError):
            continue
        if isinstance(version, str) and version:
            versions.add(version)
    if len(versions) != 1:
        raise RuntimeError("Cannot determine the installed DSH version. Check Logs; the npm cache may be missing or contain conflicting copies.")
    return versions.pop()


def refresh(npx):
    # Unlike the service, this call is deliberately online: it repopulates the
    # npx cache the offline service later starts from. The package spec must
    # match ExecStart exactly, or npx fills a cache directory the service never
    # reads. Output is captured so it never reaches notifications.
    result = subprocess.run([npx, "--yes", "@deepseek-ai/dsh", "web", "--help"], capture_output=True, text=True,
                            timeout=REFRESH_TIMEOUT)
    if result.returncode != 0:
        raise RuntimeError("Fetching the latest DSH failed. The service was left on its previous version; check Logs.")


def update(npx, home=None):
    home = home or Path.home()
    previous = installed_version(home)
    notify(f"Updating DSH from {previous}. The local service is paused while the new version is fetched; this may take up to {REFRESH_TIMEOUT // 60} minutes.", failed=False)
    was_active = active("dsh-local.service")
    if was_active:
        run("systemctl", "--user", "stop", "dsh-local.service")
    try:
        refresh(npx)
    except (RuntimeError, OSError, subprocess.SubprocessError):
        if was_active:
            subprocess.run(["systemctl", "--user", "start", "dsh-local.service"], check=False)
        raise
    current = installed_version(home)
    if was_active:
        start("local")
    restored = " The local service is running again." if was_active else ""
    if current == previous:
        notify(f"DSH is already up to date ({previous}).{restored}")
    else:
        notify(f"Updated DSH {previous} to {current}." + ("" if was_active else " Start it from the menu when you are ready."))


def main():
    available = configured_targets()
    if len(sys.argv) != 3 or sys.argv[1] not in available or sys.argv[2] not in ("start", "stop", "open", "logs", "status", "enable", "disable", "update"):
        raise RuntimeError("Usage: dsh-control TARGET {start|stop|open|logs|status|enable|disable|update}. Targets: " + ", ".join(available))
    target, action = sys.argv[1:]
    target_config = configured_targets()[target]
    unit, port = target_config["unit"], target_config["port"]
    if action == "status":
        print("running" if active(unit) else "stopped")
    elif action == "logs":
        run("omarchy-launch-terminal", "journalctl", "--user", "-u", unit, "-n", "60", "-f")
    elif action == "update":
        if target != "local":
            raise RuntimeError("Only the local target can be updated from this menu. Remote DSH installs are managed on their own hosts.")
        update(load_runtime()["npx"])
    elif action in ("enable", "disable"):
        run("systemctl", "--user", action, unit)
        notify(f"{target_config['label']} {'enabled' if action == 'enable' else 'disabled'} at login.")
    elif action == "stop":
        run("systemctl", "--user", "stop", unit)
        notify(f"{target_config['label']} {'service' if target == 'local' else 'tunnel'} stopped.")
    else:
        start(target)
        if action == "open":
            url = local_url() if target == "local" else f"http://localhost:{port}/"
            subprocess.Popen([str(Path.home() / ".local/bin/dsh-webapp"), target, url], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            notify(f"{target_config['label']} {'service' if target == 'local' else 'tunnel'} ready on port {port}.")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, RuntimeError, subprocess.CalledProcessError, OSError) as exc:
        # Do not expose command arguments: a browser command can contain a login token.
        message = str(exc) if isinstance(exc, (ValueError, RuntimeError)) else "Command failed. Check the service Logs from the menu."
        print(message, file=sys.stderr)
        notify(message, failed=True)
        sys.exit(1)
